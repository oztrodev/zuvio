# ==============================================================================
# Zuvio Ride-Hailing - Environment Configuration Template
# Santiago de Chile - 100% Electric Vehicle Fleet
# ==============================================================================

# Server Configuration
PORT=4000
HOST=127.0.0.1
RUST_LOG=info,zuvio_api=debug
ENVIRONMENT=development
DEMO_MODE=true

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Santiago de Chile Market Configuration
MARKET_TIMEZONE=America/Santiago
MARKET_CURRENCY=CLP
BASE_FARE_CLP=1400
PER_KM_CLP=650
PER_MINUTE_CLP=150
MINIMUM_FARE_CLP=3000
CANCELLATION_PENALTY_CLP=1500

# Supabase Credentials (Optional in DEMO_MODE; Required for Production)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
DATABASE_URL=postgresql://postgres:your_db_password@db.your-supabase-project.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_token

# Brevo (Sendinblue) Transactional Email Service
# In DEMO_MODE or when left blank, backend uses MockEmailProvider with structured audit logging
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hola@zuvio.cl
BREVO_SENDER_NAME=Zuvio Chile

# Map & Routing Provider (Demo Santiago routing active when blank)
MAP_PROVIDER=demo
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Frontend Environment Variables (for apps/web/.env)
# VITE_API_URL=http://localhost:4000/api/v1
# VITE_DEMO_MODE=true
# VITE_DEFAULT_COMMUNE=Providencia
# VITE_SANTIAGO_CENTER_LAT=-33.4489
# VITE_SANTIAGO_CENTER_LNG=-70.6693

