# ==========================================================
# Zuvio — .gitignore (monorepo: apps/web + services/api + supabase)
# ==========================================================

# ---------- Secretos y entorno (NUNCA subir) ----------
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.keystore
*.jks
*.mobileprovision
google-services.json
GoogleService-Info.plist

# ---------- Rust / Cargo (services/api) ----------
target/
**/target/
**/*.rs.bk
*.pdb

# ---------- Node / Vite (apps/web) ----------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
.vite/
*.tsbuildinfo
*.local
coverage/
.eslintcache
.npm/

# ---------- Capacitor nativo (Android / iOS) ----------
apps/web/android/.gradle/
apps/web/android/build/
apps/web/android/app/build/
apps/web/android/local.properties
apps/web/android/captures/
apps/web/android/.idea/
apps/web/android/app/src/main/assets/public/
apps/web/ios/App/Pods/
apps/web/ios/App/App/public/
apps/web/ios/DerivedData/
apps/web/ios/App/build/
xcuserdata/
*.xcuserstate
*.apk
*.aab
*.ipa
*.dSYM.zip

# ---------- Supabase CLI local ----------
supabase/.branches/
supabase/.temp/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ---------- Editores / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tmp
